{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/conditional/6.7.0",
  "title": "NetSuRF capability-bound conditional protection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scientific_protocol",
    "experiment",
    "benchmark",
    "samples",
    "risk",
    "candidates",
    "backgrounds",
    "execution",
    "restricted_oracle",
    "protection_context",
    "paired_swap_evaluation",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "6.7.0"
    },
    "scientific_protocol": {
      "const": "capability-conditional-protection/v8"
    },
    "experiment": {
      "type": "object"
    },
    "benchmark": {
      "type": "object",
      "required": [
        "adapter",
        "id",
        "split",
        "inference_backend",
        "quantization",
        "quantization_backend",
        "injectable_parameters"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "mlperf_tiny_ic_int8_v1",
            "mlperf_tiny_kws_int8_v1"
          ]
        },
        "inference_backend": {
          "const": "tensorflow_lite_builtin_ref_v1"
        },
        "quantization": {
          "const": "tflite_affine_int8"
        },
        "quantization_backend": {
          "const": "tflite_affine_integer_v1"
        },
        "injectable_parameters": {
          "const": [
            "kernels"
          ]
        }
      }
    },
    "samples": {
      "type": "object"
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction"
      ],
      "properties": {
        "metric": {
          "const": "categorical_crossentropy"
        },
        "direction": {
          "const": "minimize"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12
    },
    "backgrounds": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "restricted_oracle": {
      "type": "object",
      "required": [
        "enabled",
        "budget",
        "calibration_background_count",
        "evaluation_background_count",
        "calibration_seed",
        "evaluation_seed",
        "calibration_replicate_seeds"
      ]
    },
    "protection_context": {
      "type": "object"
    },
    "paired_swap_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "background_count",
        "seed",
        "comparisons"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "background_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "restricted_selected_vs_original_s5",
              "restricted_selected_vs_exact_isolated",
              "exact_isolated_vs_original_s5"
            ]
          }
        }
      }
    },
    "output": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "purpose",
        "candidate_provenance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "selection_only",
            "final_only"
          ]
        },
        "purpose": {
          "enum": [
            "engineering",
            "confirmation"
          ]
        },
        "candidate_provenance": {
          "enum": [
            "independent_s5_status_stratified_uniform_without_replacement/v1",
            "prespecified_explicit_engineering/v1"
          ]
        },
        "selection_bundle": {
          "type": "string",
          "minLength": 1
        },
        "selection_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "campaign_manifest": {
          "type": "string"
        },
        "campaign_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pool_id": {
          "type": "string",
          "pattern": "^pool_[0-9]{3}$"
        },
        "record_per_input": {
          "type": "boolean"
        },
        "final_registry": {
          "type": "string"
        },
        "final_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "dependentRequired": {
        "campaign_manifest": [
          "campaign_sha256",
          "pool_id",
          "record_per_input"
        ],
        "campaign_sha256": [
          "campaign_manifest",
          "pool_id"
        ],
        "pool_id": [
          "campaign_manifest",
          "campaign_sha256"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["workflow"]},
      "then": {"properties": {"paired_swap_evaluation": {"properties": {
        "background_count": {"minimum": 2}
      }}}}
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "mode": {
                "const": "selection_only"
              }
            }
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "paired_swap_evaluation": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "workflow": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "selection_bundle"
                  ]
                },
                {
                  "required": [
                    "selection_payload_sha256"
                  ]
                },
                {
                  "required": [
                    "selection_artifact_sha256"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "paired_swap_evaluation": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "workflow": {
            "required": [
              "selection_bundle",
              "selection_payload_sha256",
              "selection_artifact_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workflow"
        ],
        "properties": {
          "workflow": {
            "required": [
              "campaign_manifest"
            ],
            "properties": {
              "mode": {
                "const": "final_only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "workflow": {
            "required": [
              "final_registry",
              "final_registry_sha256"
            ]
          }
        }
      }
    }
  ]
}
