{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.invalid/schemas/conditional/v1.schema.json",
  "title": "NetSuRF exact conditional-damage configuration 6.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "risk", "candidates", "backgrounds", "execution", "output"],
  "properties": {
    "schema_version": {"const": "6.0.0"},
    "scientific_protocol": {"const": "exact-conditional-damage/v1"},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["name", "description", "objective"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "objective": {"type": "string"}}},
    "benchmark": {"type": "object", "additionalProperties": false, "required": ["adapter", "id", "checkpoint", "dataset", "asset_lock", "inference_backend", "split", "quantization", "quantization_backend", "injectable_parameters"], "properties": {"adapter": {"const": "mlperf_tiny_kws_int8_v1"}, "id": {"type": "string"}, "checkpoint": {"type": "string"}, "dataset": {"type": "string"}, "asset_lock": {"type": "string"}, "inference_backend": {"const": "tensorflow_lite_builtin_ref_v1"}, "split": {"type": "string"}, "quantization": {"type": "string"}, "quantization_backend": {"const": "tflite_affine_integer_v1"}, "injectable_parameters": {"const": ["kernels"]}}},
    "samples": {"type": "object", "additionalProperties": false, "required": ["calibration_count", "evaluation_count", "calibration_offset", "evaluation_offset", "require_disjoint"], "properties": {"calibration_count": {"type": "integer", "minimum": 1}, "evaluation_count": {"type": "integer", "minimum": 1}, "calibration_offset": {"type": "integer", "minimum": 0}, "evaluation_offset": {"type": "integer", "minimum": 0}, "require_disjoint": {"const": true}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["metric", "direction"], "properties": {"metric": {"const": "categorical_crossentropy"}, "direction": {"const": "minimize"}}},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["parameter", "flat_index", "bit_index"], "properties": {"parameter": {"type": "string"}, "flat_index": {"type": "integer", "minimum": 0}, "bit_index": {"type": "integer", "minimum": 0, "maximum": 7}}}},
    "backgrounds": {"type": "object", "additionalProperties": false, "required": ["probabilities", "calibration_count", "evaluation_count", "calibration_seed", "evaluation_seed"], "properties": {"probabilities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "calibration_count": {"type": "integer", "minimum": 1}, "evaluation_count": {"type": "integer", "minimum": 1}, "calibration_seed": {"type": "integer"}, "evaluation_seed": {"type": "integer"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["confidence"], "properties": {"confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}},
    "restricted_oracle": {"type": "object"},
    "output": {"type": "object", "additionalProperties": false, "required": ["root", "report", "plots"], "properties": {"root": {"type": "string"}, "report": {"type": "boolean"}, "plots": {"const": false}}}
  }
}
