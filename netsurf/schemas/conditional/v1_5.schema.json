{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.invalid/schemas/conditional/v1_5.schema.json",
  "title": "NetSuRF independent frozen-mask replication 6.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scientific_protocol",
    "experiment",
    "benchmark",
    "samples",
    "risk",
    "candidates",
    "backgrounds",
    "execution",
    "restricted_oracle",
    "protection_context",
    "paired_swap_evaluation",
    "output",
    "workflow"
  ],
  "properties": {
    "schema_version": {
      "const": "6.5.0"
    },
    "scientific_protocol": {
      "const": "independent-frozen-mask-replication/v6"
    },
    "experiment": {
      "type": "object"
    },
    "benchmark": {
      "type": "object"
    },
    "samples": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "backgrounds": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "restricted_oracle": {
      "type": "object",
      "required": [
        "enabled",
        "budget",
        "calibration_background_count",
        "evaluation_background_count",
        "calibration_seed",
        "evaluation_seed",
        "calibration_replicate_seeds"
      ]
    },
    "protection_context": {
      "type": "object"
    },
    "paired_swap_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "background_count",
        "seed",
        "comparisons"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "background_count": {
          "type": "integer",
          "minimum": 2
        },
        "seed": {
          "type": "integer"
        },
        "comparisons": {
          "const": [
            "restricted_selected_vs_original_s5",
            "restricted_selected_vs_exact_isolated",
            "exact_isolated_vs_original_s5"
          ]
        }
      }
    },
    "output": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "purpose",
        "candidate_provenance",
        "selection_bundle",
        "selection_payload_sha256",
        "selection_artifact_sha256"
      ],
      "properties": {
        "mode": {
          "const": "replication_only"
        },
        "record_per_input": {
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "engineering",
            "confirmation"
          ]
        },
        "candidate_provenance": {
          "const": "exploratory_frozen_m953_pool"
        },
        "selection_bundle": {
          "type": "string",
          "minLength": 1
        },
        "selection_payload_sha256": {
          "const": "6acf2a45452432e64186f52c3ffa6dfd2f298765106c1282ee220ef5823f0ff7"
        },
        "selection_artifact_sha256": {
          "const": "675ac2b3a46a1555fb0f4da86a0808c96ca2b4ad961e66b68a4284f97286b046"
        },
        "replication_plan": {
          "type": "string",
          "minLength": 1
        },
        "replication_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "dependentRequired": {
        "replication_plan": [
          "replication_plan_sha256"
        ],
        "replication_plan_sha256": [
          "replication_plan"
        ]
      }
    }
  }
}
