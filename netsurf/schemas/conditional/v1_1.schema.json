{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.invalid/schemas/conditional/v1_1.schema.json",
  "title": "NetSuRF same-distribution conditional protection configuration 6.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "risk", "candidates", "backgrounds", "execution", "restricted_oracle", "output"],
  "properties": {
    "schema_version": {"const": "6.1.0"},
    "scientific_protocol": {"const": "exact-conditional-protection/v2"},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["name", "description", "objective"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "objective": {"type": "string"}}},
    "benchmark": {"type": "object", "additionalProperties": false, "required": ["adapter", "id", "checkpoint", "dataset", "asset_lock", "inference_backend", "split", "quantization", "quantization_backend", "injectable_parameters"], "properties": {"adapter": {"const": "mlperf_tiny_kws_int8_v1"}, "id": {"const": "mlperf-tiny/kws"}, "checkpoint": {"type": "string"}, "dataset": {"type": "string"}, "asset_lock": {"type": "string"}, "inference_backend": {"const": "tensorflow_lite_builtin_ref_v1"}, "split": {"const": "full_test_4890"}, "quantization": {"type": "string"}, "quantization_backend": {"const": "tflite_affine_integer_v1"}, "injectable_parameters": {"const": ["kernels"]}}},
    "samples": {"type": "object", "additionalProperties": false, "required": ["calibration_role", "calibration_count", "calibration_offset", "model_selection_role", "model_selection_count", "model_selection_offset", "evaluation_role", "evaluation_count", "evaluation_offset", "require_disjoint"], "properties": {"calibration_role": {"const": "conditional_calibration"}, "calibration_count": {"type": "integer", "minimum": 1, "maximum": 1024}, "calibration_offset": {"type": "integer", "minimum": 0}, "model_selection_role": {"const": "conditional_model_selection"}, "model_selection_count": {"type": "integer", "minimum": 1, "maximum": 1024}, "model_selection_offset": {"type": "integer", "minimum": 0}, "evaluation_role": {"const": "conditional_final_evaluation"}, "evaluation_count": {"type": "integer", "minimum": 1, "maximum": 1842}, "evaluation_offset": {"type": "integer", "minimum": 0}, "require_disjoint": {"const": true}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["metric", "direction"], "properties": {"metric": {"const": "categorical_crossentropy"}, "direction": {"const": "minimize"}}},
    "candidates": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["parameter", "flat_index", "bit_index"], "properties": {"parameter": {"type": "string"}, "flat_index": {"type": "integer", "minimum": 0}, "bit_index": {"type": "integer", "minimum": 0, "maximum": 7}}}},
    "backgrounds": {"type": "object", "additionalProperties": false, "required": ["probabilities", "calibration_count", "evaluation_count", "calibration_seed", "evaluation_seed"], "properties": {"probabilities": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "calibration_count": {"type": "integer", "minimum": 1}, "evaluation_count": {"type": "integer", "minimum": 1}, "calibration_seed": {"type": "integer"}, "evaluation_seed": {"type": "integer"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["confidence"], "properties": {"confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}},
    "restricted_oracle": {"type": "object", "additionalProperties": false, "required": ["enabled", "budget", "calibration_background_count", "evaluation_background_count", "calibration_seed", "evaluation_seed"], "properties": {"enabled": {"const": true}, "budget": {"type": "integer", "minimum": 1}, "calibration_background_count": {"type": "integer", "minimum": 1}, "evaluation_background_count": {"type": "integer", "minimum": 1}, "calibration_seed": {"type": "integer"}, "evaluation_seed": {"type": "integer"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["root", "report", "plots"], "properties": {"root": {"type": "string"}, "report": {"type": "boolean"}, "plots": {"const": false}}}
  }
}
