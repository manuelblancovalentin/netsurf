{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v4.schema.json",
  "title": "NetSuRF conditional protection search configuration",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "estimators", "guidance", "initial_mask", "search", "polar", "fault", "final_evaluation", "replications", "output"],
  "properties": {
    "schema_version": {"const": "4.0.0"},
    "scientific_protocol": {"const": "conditional-protection-search/v1"},
    "experiment": {"type": "object"}, "benchmark": {"type": "object"},
    "samples": {"type": "object"}, "estimators": {"type": "array", "minItems": 1},
    "guidance": {"type": "array", "minItems": 1}, "initial_mask": {"type": "object"},
    "search": {"type": "object"}, "polar": {"type": "object"}, "fault": {"type": "object"},
    "final_evaluation": {"type": "object"}, "replications": {"type": "object"}, "output": {"type": "object"}
  },
  "additionalProperties": false,
  "description": "load_search additionally enforces strict fields, cross-field constraints, and implementation versions."
}
