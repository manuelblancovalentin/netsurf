{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v3_6.schema.json",
  "title": "Published-form FKeras continuous-companion studies on pinned INT8 benchmarks",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "candidates", "estimators", "policies", "protection", "fault", "execution", "output"],
  "properties": {
    "schema_version": {"const": "3.6.0"},
    "scientific_protocol": {"enum": ["single-bit-susceptibility/v1", "estimator-validation/v1", "ranking-policy-comparison/v1", "multi-coverage-protection/v1"]},
    "experiment": {"type": "object"},
    "benchmark": {"type": "object"},
    "samples": {"type": "object"},
    "candidates": {"type": "object"},
    "estimators": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "implementation_version"],
        "properties": {
          "name": {"type": "string"},
          "implementation_version": {"type": "string"},
          "seed": {"type": "integer"},
          "probes": {"type": "integer", "minimum": 1},
          "result_name": {"type": "string"},
          "hessian": {
            "type": "object",
            "required": ["eigenpairs", "max_iterations", "max_products", "tolerance", "ordering"],
            "properties": {
              "eigenpairs": {"type": "integer", "minimum": 1, "maximum": 264191},
              "max_iterations": {"type": "integer", "minimum": 1},
              "max_products": {"type": "integer", "minimum": 1},
              "tolerance": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
              "ordering": {"const": "largest_magnitude_signed"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "policies": {"type": "array"},
    "protection": {"type": "object"},
    "fault": {"type": "object"},
    "execution": {"type": "object"},
    "replications": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": false
}
