{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v4_2.schema.json",
  "title": "NetSuRF topology-aware conditional protection search configuration",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "estimators", "guidance", "initial_mask", "methods", "search", "polar", "topology", "fault", "final_evaluation", "replications", "output"],
  "properties": {
    "schema_version": {"const": "4.2.0"},
    "scientific_protocol": {"const": "topology-aware-conditional-search/v1"},
    "experiment": {"type": "object"}, "benchmark": {"type": "object"},
    "samples": {"type": "object"}, "estimators": {"type": "array", "minItems": 1},
    "guidance": {"type": "array", "minItems": 1}, "initial_mask": {"type": "object"},
    "methods": {"type": "array", "minItems": 1}, "search": {"type": "object"},
    "polar": {"type": "object"}, "topology": {"type": "object"},
    "fault": {"type": "object"}, "final_evaluation": {"type": "object"},
    "replications": {"type": "object"}, "output": {"type": "object"}
  },
  "additionalProperties": false,
  "description": "load_search strictly validates layer discovery budgets, interaction models, method ablations, strata, and controlled held-out evaluation."
}
