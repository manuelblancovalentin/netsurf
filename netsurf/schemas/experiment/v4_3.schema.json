{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v4_3.schema.json",
  "title": "NetSuRF mask-aware conditional screening configuration",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "estimators", "guidance", "initial_mask", "methods", "search", "polar", "topology", "screening", "fault", "final_evaluation", "replications", "output"],
  "properties": {
    "schema_version": {"const": "4.3.0"},
    "scientific_protocol": {"const": "mask-aware-conditional-screening/v1"},
    "experiment": {"type": "object"}, "benchmark": {"type": "object"},
    "samples": {"type": "object"}, "estimators": {"type": "array", "minItems": 1},
    "guidance": {"type": "array", "minItems": 1}, "initial_mask": {"type": "object"},
    "methods": {"type": "array", "minItems": 1}, "search": {"type": "object"},
    "polar": {"type": "object"}, "topology": {"type": "object"},
    "screening": {"type": "object"}, "fault": {"type": "object"},
    "final_evaluation": {"type": "object"}, "replications": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": false,
  "description": "load_search strictly validates screening shortlists, factorized population scope, dynamic updates, pair corrections, and controlled held-out evaluation."
}
