{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v1.schema.json",
  "title": "NetSuRF experiment configuration",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "estimators", "protection", "fault", "execution", "output"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scientific_protocol": {"const": "legacy-mnist-persistent-weight/v1"},
    "experiment": {"type": "object", "required": ["name", "description"]},
    "benchmark": {"type": "object", "required": ["adapter", "id", "checkpoint", "dataset", "split", "evaluation_samples", "ranking_samples", "quantization"]},
    "estimators": {"type": "array", "minItems": 1},
    "protection": {"type": "object", "required": ["coverage"]},
    "fault": {"type": "object", "required": ["target", "location", "persistence", "distribution", "probability"]},
    "execution": {"type": "object", "required": ["trials", "confidence", "random_ranking_seed", "fault_seed"]},
    "output": {"type": "object", "required": ["report", "plots"]}
  },
  "additionalProperties": false
}
