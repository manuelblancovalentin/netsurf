{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v3_4.schema.json",
  "title": "NetSuRF M9.3 multi-benchmark estimator and protection study",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "candidates", "estimators", "policies", "protection", "fault", "execution", "output"],
  "properties": {
    "schema_version": {"const": "3.4.0"},
    "scientific_protocol": {"enum": ["single-bit-susceptibility/v1", "estimator-validation/v1", "ranking-policy-comparison/v1", "multi-coverage-protection/v1"]},
    "experiment": {"type": "object"},
    "benchmark": {"type": "object", "properties": {"asset_lock": {"type": "string"}, "inference_backend": {"type": "string"}}},
    "samples": {"type": "object"},
    "candidates": {"type": "object"},
    "estimators": {"type": "array", "minItems": 1},
    "policies": {"type": "array"},
    "protection": {"type": "object"},
    "fault": {"type": "object"},
    "execution": {"type": "object"},
    "replications": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": false
}
