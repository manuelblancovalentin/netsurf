{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsurf.local/schemas/experiment/v4_4.schema.json",
  "title": "NetSuRF controlled factorized-guidance ablation configuration",
  "type": "object",
  "required": ["schema_version", "scientific_protocol", "experiment", "benchmark", "samples", "estimators", "guidance", "initial_mask", "methods", "search", "polar", "topology", "screening", "proposal_control", "factor_cache", "fault", "final_evaluation", "replications", "output"],
  "properties": {
    "schema_version": {"const": "4.4.0"},
    "scientific_protocol": {"const": "factorized-guidance-ablation/v1"},
    "experiment": {"type": "object"}, "benchmark": {"type": "object"},
    "samples": {"type": "object"}, "estimators": {"type": "array", "minItems": 1},
    "guidance": {"type": "array", "minItems": 1}, "initial_mask": {"type": "object"},
    "methods": {"type": "array", "minItems": 1}, "search": {"type": "object"},
    "polar": {"type": "object"}, "topology": {"type": "object"},
    "screening": {"type": "object"},
    "proposal_control": {
      "type": "object",
      "required": ["candidate_universe", "verification_budget", "shared_backgrounds", "enforce_equal_iterations"],
      "properties": {
        "candidate_universe": {"const": "shared_candidate_pool"},
        "verification_budget": {"type": "integer", "minimum": 1},
        "shared_backgrounds": {"const": true},
        "enforce_equal_iterations": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "factor_cache": {
      "type": "object",
      "required": ["enabled", "scope", "vectorized_queries"],
      "properties": {
        "enabled": {"type": "boolean"}, "scope": {"const": "run"},
        "vectorized_queries": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fault": {"type": "object"}, "final_evaluation": {"type": "object"},
    "replications": {"type": "object"}, "output": {"type": "object"}
  },
  "additionalProperties": false,
  "description": "load_search additionally validates method-level proposal models, structural shuffling, equal controlled iteration budgets, and fixed exact-verification budgets."
}
